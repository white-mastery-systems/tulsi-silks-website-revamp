{
  "name": "ecommerce",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:ssr": "ng run ecommerce:serve-ssr",
    "serve:ssr": "node dist/ecommerce/server/main.js",
    "build:ssr": "ng build && ng run ecommerce:server",
    "prerender": "ng run ecommerce:prerender",
    "analyze": "ng build --configuration production --stats-json && webpack-bundle-analyzer dist/ecommerce/browser/stats.json",
    "compress-images": "node scripts/compress-images.js",
    "compress-images:dry": "node scripts/compress-images.js --dry-run",
    "optimize:mobile-hero": "node scripts/optimize-mobile-hero-webp.js",
    "optimize:mobile-hero:install": "node scripts/install-mobile-hero-asset.js"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular-slider/ngx-slider": "^20.0.0",
    "@angular/animations": "^20.3.19",
    "@angular/common": "^20.3.19",
    "@angular/compiler": "^20.3.19",
    "@angular/core": "^20.3.19",
    "@angular/forms": "^20.3.19",
    "@angular/platform-browser": "^20.3.19",
    "@angular/platform-browser-dynamic": "^20.3.19",
    "@angular/platform-server": "^20.3.19",
    "@angular/router": "^20.3.19",
    "@angular/ssr": "^20.3.25",
    "@angular/youtube-player": "^20.2.14",
    "angularx-qrcode": "^20.0.0",
    "crypto-js": "^4.2.0",
    "editorjs-html": "^4.0.5",
    "express": "^4.15.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "localstorage-polyfill": "^1.0.1",
    "lucide-angular": "^0.511.0",
    "ng-connection-service": "^1.0.4",
    "ngx-bootstrap": "^20.0.2",
    "ngx-device-detector": "^3.0.0",
    "ngx-pagination": "^6.0.3",
    "photoswipe": "^4.1.3",
    "request": "^2.88.2",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.25",
    "@angular/cli": "^20.3.25",
    "@angular/compiler-cli": "^20.3.19",
    "@types/express": "^4.17.0",
    "@types/jasmine": "~3.10.0",
    "@types/node": "^20.14.0",
    "browser-sync": "^3.0.0",
    "jasmine-core": "~4.0.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.1.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "sharp": "^0.34.5",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "ora": "5.4.1"
  }
}
