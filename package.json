{
  "name": "ecommerce",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:ssr": "ng run ecommerce:serve-ssr",
    "serve:ssr": "node dist/ecommerce/server/main.js",
    "build:ssr": "ng build && ng run ecommerce:server",
    "prerender": "ng run ecommerce:prerender",
    "analyze": "ng build --prod --stats-json && webpack-bundle-analyzer dist/ecommerce/browser/stats.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~13.3.0",
    "@angular/common": "~13.3.0",
